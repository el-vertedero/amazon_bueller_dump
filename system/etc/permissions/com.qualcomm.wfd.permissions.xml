<permissions>
    <!-- ACOS_MOD_BEGIN -->
    <!-- Allow WfdCommon to be used by apk's with 'uses-library' -->
    <library name="WfdCommon" file="/system/framework/WfdCommon.jar" />
    <!-- ACOS_MOD_END -->

    <!-- Access DHCP client info from DHCP table during P2P connection
         from /data/misc/dhcp -->
    <permission name="com.qualcomm.permission.READ_DHCP_INFO" >
        <group gid="dhcp" />
    </permission>
</permissions>
